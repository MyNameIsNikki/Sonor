{
  "name": "Sonor",
  "version": "1.1.0",
  "description": "Music player with VK Music, Yandex Music, and Spotify imports in blue theme",
  "main": "node_modules/expo/AppEntry.js",
  "author": "Sonor Music",
  "license": "MIT",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "eas build -p android --profile preview",
    "build:ios": "eas build -p ios --profile preview",
    "build:windows": "electron-builder --win --config electron-builder.config.js",
    "start:desktop": "electron electron-main.js",
    "make:exe": "electron-builder --win --config electron-builder.config.js"
  },
  "dependencies": {
    "expo": "~49.0.0",
    "react": "18.2.0",
    "react-native": "0.72.10",
    "expo-av": "~13.4.1",
    "expo-linear-gradient": "~12.3.0",
    "expo-blur": "~12.4.1",
    "expo-media-library": "~15.4.1",
    "expo-file-system": "~15.4.1",
    "blueimp-md5": "^2.19.0",
    "react-native-vector-icons": "^10.0.0",
    "uuid": "^9.0.0",
    "expo-splash-screen": "~0.20.5",
    "expo-status-bar": "~1.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.0",
    "@types/react-native": "~0.72.0",
    "electron": "^27.0.0",
    "electron-builder": "^24.0.0",
    "eas-cli": "^3.0.0"
  },
  "overrides": {
    "@babel/traverse": "7.28.6"
  }
}
