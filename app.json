{
 "expo": {
 "name": "Sonor",
 "slug": "sonor",
 "version": "1.5.1",
 "description": "Music player with VK, Yandex and Spotify import, free music catalogs and secure OAuth in a blue theme",
 "orientation": "portrait",
 "icon": "./icon.png",
 "userInterfaceStyle": "dark",
 "splash": {
 "image": "./splash.png",
 "backgroundColor": "#060d12"
 },
 "updates": {
 "fallbackToCacheTimeout": 0
 },
 "assetBundlePatterns": ["**/*"],
 "ios": {
 "bundleIdentifier": "com.sonor.music",
 "buildNumber": "5",
 "infoPlist": {
 "NSCameraUsageDescription": "Это приложение не использует камеру",
 "NSMicrophoneUsageDescription": "Это приложение использует микрофон для записи аудио"
 }
 },
 "android": {
 "package": "com.sonor.music",
 "versionCode": 5,
 "permissions": ["READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE", "READ_MEDIA_AUDIO"]
 },
 "web": {
 "favicon": {
 "input": "./icon.png"
 }
 }
 }
}